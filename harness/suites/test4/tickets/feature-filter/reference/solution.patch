+#[test]
+fn list_entities_filters_by_device_class_and_can_count_only() {
+    let fake = FakeHa::standard();
+    let client = common::Client::start(&fake.url);
+
+    let by_class = call(
+        &client,
+        "list_entities",
+        json!({"device_class": "Temperature"}),
+    )
+    .expect_structured("list_entities by device class");
+    assert_eq!(by_class["total_entities"], 6);
+    assert_eq!(by_class["matched"], 1, "the match is case-insensitive");
+    assert_eq!(
+        by_class["entities"][0]["entity_id"],
+        "sensor.outside_temperature"
+    );
+
+    let none = call(&client, "list_entities", json!({"device_class": "gas"}))
+        .expect_structured("list_entities with an unused device class");
+    assert_eq!(none["matched"], 0);
+    assert_eq!(none["entities"], json!([]));
+
+    let unfiltered = call(&client, "list_entities", json!({"device_class": ""}))
+        .expect_structured("list_entities with an empty device class");
+    assert_eq!(unfiltered["matched"], 6, "empty means no filter");
+
+    let counted = call(&client, "list_entities", json!({"count_only": true}))
+        .expect_structured("list_entities count only");
+    assert_eq!(counted["matched"], 6);
+    assert_eq!(counted["total_entities"], 6);
+    assert_eq!(counted["returned"], 0);
+    assert_eq!(counted["entities"], json!([]));
+    assert!(counted["next_cursor"].is_null());
+
+    let counted_lights = call(
+        &client,
+        "list_entities",
+        json!({"count_only": true, "domain": "light", "limit": 1}),
+    )
+    .expect_structured("list_entities count only, filtered");
+    assert_eq!(counted_lights["matched"], 2);
+    assert_eq!(counted_lights["returned"], 0);
+    assert!(counted_lights["next_cursor"].is_null());
+
+    let wrong_type = call(&client, "list_entities", json!({"count_only": "yes"}));
+    assert_eq!(
+        wrong_type.expect_tool_error("a string for count_only")["_meta"]["errorKind"],
+        "invalid-arguments"
+    );
+}

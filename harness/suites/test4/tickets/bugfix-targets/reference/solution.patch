+/// Whether a service declares an entity target.
+///
+/// Home Assistant has published two shapes for this. Current releases list entity
+/// filters under `target.entity` (`{"entity": [{"domain": ["lock"]}]}`); older ones
+/// put a selector under `target.entity_id`. A `target` that is present but empty
+/// accepts any entity, device or area. A service with no `target` takes none, even
+/// when one of its fields happens to be called `entity_id`.
+fn targets_entities(definition: &Value) -> bool {
+    match definition.get("target").and_then(Value::as_object) {
+        Some(target) => {
+            target.is_empty() || target.contains_key("entity") || target.contains_key("entity_id")
+        }
+        None => false,
+    }
+}

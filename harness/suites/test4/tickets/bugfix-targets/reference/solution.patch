+#[test]
+fn list_services_recognises_both_entity_target_shapes() {
+    // Current Home Assistant publishes `target.entity` (a list of filters); older
+    // releases published `target.entity_id`. Both mean "this service takes entities".
+    let catalog = json!([
+        {
+            "domain": "lock",
+            "services": {
+                "lock": {"target": {"entity": [{"domain": ["lock"]}]}, "fields": {}},
+                "open": {
+                    "target": {"entity": [{"domain": ["lock"], "supported_features": [1]}]},
+                    "fields": {}
+                },
+                "legacy": {"target": {"entity_id": {}}, "fields": {}}
+            }
+        },
+        {
+            "domain": "homeassistant",
+            "services": {
+                "restart": {"fields": {}},
+                "update_entity": {
+                    "fields": {"entity_id": {"required": true, "selector": {"entity": {}}}}
+                }
+            }
+        }
+    ]);
+    let fake = FakeHa::start(TOKEN, vec![("/api/services", common::Response::ok(catalog))]);
+    let client = common::Client::start(&fake.url);
+
+    let listed = call(&client, "list_services", json!({})).expect_structured("list_services");
+    let flag = |domain: &str, service: &str| -> Value {
+        listed["services"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .find(|row| row["domain"] == domain && row["service"] == service)
+            .unwrap_or_else(|| panic!("{domain}.{service} is listed"))["targets_entities"]
+            .clone()
+    };
+    assert_eq!(flag("lock", "lock"), true, "target.entity is an entity target");
+    assert_eq!(flag("lock", "open"), true, "extra filters do not change that");
+    assert_eq!(flag("lock", "legacy"), true, "target.entity_id still counts");
+    assert_eq!(flag("homeassistant", "restart"), false, "no target at all");
+    assert_eq!(
+        flag("homeassistant", "update_entity"),
+        false,
+        "a field named entity_id is not a target"
+    );
+}

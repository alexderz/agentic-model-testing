+#[test]
+fn transient_failures_are_retried_only_when_asked() {
+    let down = || {
+        vec![(
+            "/api/config",
+            common::Response::json(503, json!({"message": "restarting"})),
+        )]
+    };
+
+    let fake = FakeHa::start(TOKEN, down());
+    let client = common::Client::start(&fake.url);
+    let result = call(&client, "get_config", json!({})).expect_tool_error("a 503 without retries");
+    assert_eq!(result["_meta"]["errorKind"], "http-status");
+    assert_eq!(fake.count("/api/config"), 1, "the default is one attempt");
+
+    let fake = FakeHa::start(TOKEN, down());
+    let client = common::Client::with_env(
+        &fake.url,
+        TOKEN,
+        &[("HA_MCP_RETRIES", "2"), ("HA_MCP_RETRY_DELAY_MS", "0")],
+    );
+    let result = call(&client, "get_config", json!({})).expect_tool_error("a 503 with retries");
+    assert_eq!(result["_meta"]["httpStatus"], 503);
+    assert_eq!(fake.count("/api/config"), 3, "one attempt plus two retries");
+
+    let fake = FakeHa::start(TOKEN, vec![]);
+    let client = common::Client::with_env(
+        &fake.url,
+        TOKEN,
+        &[("HA_MCP_RETRIES", "3"), ("HA_MCP_RETRY_DELAY_MS", "0")],
+    );
+    let result = call(&client, "get_config", json!({})).expect_tool_error("a 404 with retries on");
+    assert_eq!(result["_meta"]["errorKind"], "not-found");
+    assert_eq!(fake.count("/api/config"), 1, "a 404 is final");
+}

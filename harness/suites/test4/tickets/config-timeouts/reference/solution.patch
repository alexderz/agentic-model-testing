+/// Failures worth another attempt: the connection could not be made, the request
+/// timed out, or a gateway said the instance is not ready (502, 503, 504). Anything
+/// Home Assistant actually decided - a 4xx, a 500, an unusable body - is final.
+fn is_transient(error: &HaError) -> bool {
+    match error {
+        HaError::Timeout { .. } | HaError::Unreachable { .. } => true,
+        HaError::Status { status, .. } => matches!(status, 502..=504),
+        _ => false,
+    }
+}

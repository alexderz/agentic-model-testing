# Default db image: PostgreSQL from Fedora's package on a current Fedora base (the official
# postgres image carries a Go helper with unfixed-in-image CVEs we never use). The preflight rebuilds
# it when stale or vulnerable. Runs as the postgres user; the data directory is a tmpfs (throwaway),
# initialised at every start. Credentials come from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
FROM registry.fedoraproject.org/fedora-minimal:44
RUN microdnf -y --setopt=install_weak_deps=0 upgrade && microdnf -y --setopt=install_weak_deps=0 install postgresql-server \
 && microdnf clean all && rpm -q postgresql-server > /postgres-version
USER postgres
ENV PGDATA=/var/lib/pgsql/data
ENTRYPOINT ["/bin/sh", "-ec", "\
  printf '%s' \"$POSTGRES_PASSWORD\" > /tmp/pw; \
  initdb -D \"$PGDATA\" -U \"$POSTGRES_USER\" --pwfile=/tmp/pw --auth-local=scram-sha-256 --auth-host=scram-sha-256 >/dev/null; \
  rm -f /tmp/pw; \
  echo \"host all all 0.0.0.0/0 scram-sha-256\" >> \"$PGDATA/pg_hba.conf\"; \
  pg_ctl -D \"$PGDATA\" -o '-c listen_addresses=localhost' -w start >/dev/null; \
  [ \"$POSTGRES_DB\" = postgres ] || PGPASSWORD=\"$POSTGRES_PASSWORD\" createdb -h localhost -U \"$POSTGRES_USER\" \"$POSTGRES_DB\"; \
  pg_ctl -D \"$PGDATA\" -m fast -w stop >/dev/null; \
  exec postgres -D \"$PGDATA\" -c listen_addresses='*' -c unix_socket_directories=/run/postgresql"]

+// FP8 prefill needs FP8 MMA (compute capability 8.9). On older GPUs this stub is built in its place and refuses;
+// prompts run the bf16 kernel (qmm_prefill.cu), the default.
+
+#include <ATen/ATen.h>
+
+void qmm_prefill8_cuda(const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                       const at::Tensor&, at::Tensor&, int, int, bool, int) {
+    TORCH_CHECK(false, "FP8 prompts (--prefill-fp8) need compute capability 8.9 or newer; drop the flag");
+}
+
+void qmm_prefill8w_cuda(const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&, at::Tensor&, int,
+                        int, bool, int, bool) {
+    TORCH_CHECK(false, "FP8 prompt weights need compute capability 8.9 or newer");
+}

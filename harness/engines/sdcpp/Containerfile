# stable-diffusion.cpp sd-server (web UI embedded + OpenAI-style images API), CUDA sm86.
# Pinned to release master-929-3f8527a (2026-09-27; Qwen-Image 2.1 support since 2026-09-20).
ARG CUDA=12.8.1
FROM docker.io/nvidia/cuda:${CUDA}-devel-ubuntu24.04 AS build
RUN apt-get update && apt-get install -y --no-install-recommends git cmake build-essential ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=docker.io/library/node:22-bookworm /usr/local /usr/local
RUN npm install -g pnpm@9
ARG SD_TAG=master-929-3f8527a
RUN git clone -q --depth 1 --branch ${SD_TAG} --recursive --shallow-submodules https://github.com/leejet/stable-diffusion.cpp /src/sd
RUN cd /src/sd && cmake -B build -DSD_CUDA=ON -DCMAKE_CUDA_ARCHITECTURES=86 -DGGML_NATIVE=OFF -DSD_SERVER_BUILD_FRONTEND=ON \
      -DCMAKE_EXE_LINKER_FLAGS="-L/usr/local/cuda/lib64/stubs -Wl,--allow-shlib-undefined" \
 && cmake --build build --config Release -j$(nproc) --target sd-server \
 && mkdir -p /out && cp build/bin/sd-server /out/

FROM docker.io/nvidia/cuda:${CUDA}-runtime-ubuntu24.04
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 curl && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/sd-server /usr/local/bin/sd-server
ENTRYPOINT ["/usr/local/bin/sd-server"]

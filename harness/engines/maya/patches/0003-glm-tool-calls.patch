+def tool_call_name(body: str) -> str:
+    """The function name of a call body in either format (bakeoff patch, see _parse_glm_tool_call)."""
+    b = body.strip()
+    if b.startswith("<function="):
+        return b[len("<function="):].split(">", 1)[0]
+    return b.split("<arg_key>", 1)[0].strip()
+
+
+def _parse_glm_tool_call(body: str, schema: dict | None = None) -> ToolCall:
+    """bakeoff patch: GLM-5.3's own chat template (the one in the pack's tokenizer dir) asks for
+    `NAME<arg_key>K</arg_key><arg_value>V</arg_value>...` inside <tool_call>, with non-string values written as JSON;
+    the upstream parser knew only the Qwen form above and rejected every GLM call as malformed."""
+    name = body.split("<arg_key>", 1)[0].strip()
+    if not name or any(c in name for c in "<>\n"):
+        raise ValueError("malformed tool call: " + body[:80])
+    props = ((schema or {}).get("parameters") or {}).get("properties") or {}
+    args, rest = {}, body[len(body.split("<arg_key>", 1)[0]):]
+    while "<arg_key>" in rest:
+        rest = rest[rest.index("<arg_key>") + len("<arg_key>"):]
+        k_end = rest.find("</arg_key>")
+        if k_end < 0:
+            raise ValueError("malformed tool call: " + body[:80])
+        key = rest[:k_end].strip()
+        rest = rest[k_end + len("</arg_key>"):]
+        v_start = rest.find("<arg_value>")
+        if v_start < 0:
+            raise ValueError("malformed tool call: " + body[:80])
+        rest = rest[v_start + len("<arg_value>"):]
+        v_end = rest.find("</arg_value>")
+        value = rest[:v_end] if v_end >= 0 else rest
+        rest = rest[v_end + len("</arg_value>"):] if v_end >= 0 else ""
+        declared = (props.get(key) or {}).get("type")
+        if declared == "string":
+            args[key] = value
+        else:
+            try:
+                args[key] = json.loads(value)
+            except ValueError:
+                args[key] = value
+    return ToolCall(name=name, arguments=args)
+
+

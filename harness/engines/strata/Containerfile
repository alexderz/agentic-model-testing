# Strata inference engine (github.com/Niko1221/Strata), containerised for evaluation on titan.
# Every input is pinned: the Strata tag and commit, the CUDA base images by digest, and the
# llama.cpp source zip by commit + sha256 (see build.sh). The internet is used only while building.
# Build context: the directory build.sh assembles (src/ = Strata checkout, inputs/ = verified zip).
ARG CUDA_DEVEL=docker.io/nvidia/cuda:13.0.2-devel-ubuntu24.04@sha256:0eee3094c71518ad31d011a594ae6ed6de72959ee07e318cb31cffe71690e90c
ARG CUDA_RUNTIME=docker.io/nvidia/cuda:13.0.2-runtime-ubuntu24.04@sha256:6a0e31b59e70890446f2c17356d6efc0d54260090a8c63d6ca7c2ad049db95d2

FROM ${CUDA_DEVEL} AS build
ARG LLAMA_CPP_COMMIT
ARG LLAMA_CPP_SHA256
ARG CUDA_ARCH=86
# nvcc takes 2-4 GB a job; build.sh passes JOBS (0.1.42 and older were built with 8)
ARG JOBS=8
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake ninja-build python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/strata
COPY src/ /opt/strata/
COPY inputs/llama.cpp-${LLAMA_CPP_COMMIT}.zip /tmp/llama.zip
RUN echo "${LLAMA_CPP_SHA256}  /tmp/llama.zip" | sha256sum -c - \
 && python3 -c "import zipfile; zipfile.ZipFile('/tmp/llama.zip').extractall('/tmp/u')" \
 && mv /tmp/u/llama.cpp-${LLAMA_CPP_COMMIT} /opt/strata/third_party/llama.cpp && rm -rf /tmp/u /tmp/llama.zip
# Same configure/build as setup.py's build_engine(), text-only (no vision encoder), for sm_86 (RTX 3090).
# Since 0.1.44 the K-quant prompt kernels are a library of their own (libstrata_kq.so next to the engine, loaded only
# for a model in those formats with STRATA_MMQ_KQ=1); setup.py copies it beside the engine, and so does this.
RUN cmake -G Ninja -S . -B build -DCMAKE_BUILD_TYPE=Release -DSTRATA_ENABLE_CUDA=ON -DSTRATA_BUILD_TESTS=OFF \
      -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCH} -DSTRATA_GGML_DIR=/opt/strata/third_party/llama.cpp \
 && (cmake --build build --target strata -j ${JOBS} || cmake --build build --target strata -j 2) \
 && mkdir -p engine && cp build/strata engine/strata \
 && if grep -q "add_library(strata_kq" CMakeLists.txt; then cmake --build build --target strata_kq -j ${JOBS} \
      && cp build/libstrata_kq.so engine/libstrata_kq.so; fi \
 && rm -rf build

FROM ${CUDA_RUNTIME}
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv libgomp1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/strata /opt/strata
COPY python-requirements.txt /tmp/req.txt
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir -r /tmp/req.txt && rm /tmp/req.txt
RUN useradd --uid 10001 --create-home strata
USER strata
WORKDIR /opt/strata
ENV PATH=/opt/venv/bin:$PATH STRATA_GGUF_PY=/opt/strata/third_party/llama.cpp/gguf-py HF_HUB_OFFLINE=1
EXPOSE 8793
ENTRYPOINT ["python", "serve/server.py", "--engine", "strata"]
